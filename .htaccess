# Force HTTPS for this project (HAVU)
RewriteEngine On

# Disable directory listing (prevents browsing folder contents like /cron/)
<IfModule mod_autoindex.c>
  Options -Indexes
  Options -MultiViews
</IfModule>

# If the request is not HTTPS, redirect to the same URL on HTTPS
# Skip redirect for localhost / 127.0.0.1 (local development)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
